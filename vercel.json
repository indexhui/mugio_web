{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "ja" }],
      "destination": "/ja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "zh-TW" }],
      "destination": "/zh-TW",
      "permanent": false
    },
    { "source": "/", "destination": "/zh-TW", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
